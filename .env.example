NODE_ENV=development
PORT=3333

# docker compose up -d gives you this database
DATABASE_URL=postgresql://app:app@localhost:5432/app
DATABASE_POOL_MAX=10

# At least 32 characters. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=3600

# Logger (all optional). See "The terminal" in the README.
# LOG_FORMAT=pretty        # pretty | json (default: json in production)
# LOG_LEVEL=info           # debug | info | warn | error
# LOG_BRAND=NESTJS         # the name in the banner's big letters
# LOG_BANNER=on            # on | off
# LOG_REQUESTS=on          # on | off: one line per HTTP request
# LOG_BACKGROUND=auto      # auto | dark | light: which palette the terminal gets
